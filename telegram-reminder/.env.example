# ===== Telegram =====
# Токен бота от @BotFather (команда /newbot)
BOT_TOKEN=

# ===== LLM: AnyModel (OpenAI-совместимый API) =====
# Ключ берётся на https://anymodel.org/app/dashboard после регистрации
LLM_API_KEY=
LLM_BASE_URL=https://anymodel.org/v1

# Модель. Рекомендуемая — дёшево и стабильно (~$0.025 за 1M токенов):
#   glm/glm-5.3-flash
# Бесплатные, но НЕСТАБИЛЬНЫЕ ($0, возможны connection error / пустой ответ):
#   am/free  |  am/nemotron-3-ultra-550b-a55b  |  am/nemotron-3.5-lightning-30b-a3b
LLM_MODEL=glm/glm-5.3-flash

# Таймаут запроса к LLM (сек) и лимит токенов ответа
LLM_TIMEOUT=45
LLM_MAX_TOKENS=800

# ===== Часовой пояс (IANA) =====
# Москва: Europe/Moscow | Киев: Europe/Kyiv | Екатеринбург: Asia/Yekaterinburg
TIMEZONE=Europe/Moscow

# ===== Файл базы данных напоминаний =====
DB_PATH=reminders.db