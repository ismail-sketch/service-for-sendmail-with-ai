# ===== Telegram =====
# Токен бота от @BotFather
BOT_TOKEN=

# ===== LLM (OpenAI-совместимый API) =====
# Примеры:
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1       LLM_MODEL=gpt-4o-mini
#   DeepSeek:    LLM_BASE_URL=https://api.deepseek.com         LLM_MODEL=deepseek-chat
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=<любая модель>
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== Часовой пояс (IANA) =====
# Москва: Europe/Moscow | Киев: Europe/Kyiv | Екатеринбург: Asia/Yekaterinburg
TIMEZONE=Europe/Moscow

# ===== Файл базы данных напоминаний =====
DB_PATH=reminders.db